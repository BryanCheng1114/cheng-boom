generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  theme     String   @default("dark")
  language  String   @default("en")
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  description        String
  videoUrl           String?
  stock              Int      @default(0)
  sellerAPrice       Float?
  category           String?
  status             String   @default("Live")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  images             String[]
  nameMs             String?
  nameZh             String?
  code               String?  @unique
  descriptionMs      String?
  descriptionZh      String?
  sellerABoxPrice    Float?
  itemsPerBox        Int?
  sellerABundlePrice Float?
  bundleQuantity     Int?
  sellerBPrice       Float?
  sellerBBoxPrice    Float?
  sellerBBundlePrice Float?
}

model Category {
  id                String   @id @default(cuid())
  name              String   @unique
  createdAt         DateTime @default(now())
  image             String?
  code              String?  @unique
  nameMs            String?
  nameZh            String?
  status            String   @default("Live")
  description       String?
  displayOrder      Int?     @default(0)
  showInAppBar      Boolean  @default(true)
  showInCategoryBar Boolean  @default(true)
}

model BusinessSettings {
  id                String   @id @default(cuid())
  businessName      String   @default("Cheng-BOOM")
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String?
  accentColor       String?
  businessType      String?
  ownerName         String?
  address           String?
  phone             String?
  email             String?
  whatsapp          String?
  description       String?
  operatingHours    String?
  facebook          String?
  instagram         String?
  tiktok            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  watermarkUrl      String?
  bankTransferImage String?
  tngDuitnowImage   String?
}

model SellerLevel {
  id              String     @id @default(cuid())
  name            String     @unique
  discountPercent Float      @default(0)
  freeShipping    Boolean    @default(false)
  prioritySupport Boolean    @default(false)
  description     String?
  customers       Customer[]
}

model Customer {
  id               String       @id @default(cuid())
  name             String
  phone            String?      @unique
  address          String?
  role             String       @default("Guest")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  password         String?
  deliveryDetails  String?
  notes            String?
  preferredPayment String?
  orderMode        String?
  isActive         Boolean      @default(true)
  sellerLevelId    String?
  email            String?      @unique
  resetToken       String?
  resetTokenExpiry DateTime?
  sellerPricing    String?
  sellerLevel      SellerLevel? @relation(fields: [sellerLevelId], references: [id])
  orders           Order[]
}

model Order {
  id                String      @id @default(cuid())
  customerId        String
  totalAmount       Float
  status            String      @default("Pending")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  address           String?
  deliveryMode      String?
  notes             String?
  paymentMethod     String?
  paymentReceiptUrl String?
  customer          Customer    @relation(fields: [customerId], references: [id])
  items             OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  variant   String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
